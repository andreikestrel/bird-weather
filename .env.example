# OpenWeatherMap — https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Unsplash — https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Google OAuth — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Emails autorizados a fazer login (separados por vírgula; deixar vazio = todos)
ALLOWED_EMAILS=

# Database (SQLite para dev, PostgreSQL para prod)
DATABASE_URL=file:./dev.db

# Web Push — gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
